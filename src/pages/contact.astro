---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Karina Ko"
  description="Get in touch"
  activeNav="contact"
>
  <section class="section">
    <div class="container" style="max-width: 560px;">
      <h1 style="margin-bottom: 0.5rem;">Contact</h1>
      <p style="color: var(--color-muted); margin-bottom: 3rem;">
        Get in touch
      </p>

      <!-- Instagram link -->
      <a
        href="https://www.instagram.com/karinakowrites"
        target="_blank"
        rel="noopener noreferrer"
        class="instagram-link"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20" height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none"/>
        </svg>
        <span>Follow on Instagram</span>
        <span class="ig-arrow">↗</span>
      </a>

      <!-- Contact form -->
      <div class="form-card">
        <h2 style="font-size: 1rem; margin-bottom: 1.5rem;">Send a message</h2>
        <form
          method="POST"
          action="https://formspree.io/f/xykbrpyq"
          >
          <div class="field">
            <label for="name">Name</label>
            <input id="name" type="text" name="name" required placeholder="Your name" />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" type="email" name="email" required placeholder="you@example.com" />
          </div>

          <div class="field">
            <label for="subject">Subject</label>
            <input id="subject" type="text" name="subject" placeholder="e.g. Commission, collaboration, event…" />
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" required rows="5" placeholder="Hello…"></textarea>
          </div>

          <button type="submit" class="btn btn-filled" style="cursor:pointer; font-family:var(--font-sans);">
            Send message
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .instagram-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.65rem 1.1rem;
    background: var(--color-surface);
    margin-bottom: 3rem;
    transition: border-color 0.15s;
    width: auto;
    max-width: 100%;
  }
  .instagram-link:hover {
    border-color: var(--color-accent);
    opacity: 1;
  }
  .ig-arrow {
    color: var(--color-muted);
    font-size: 0.8rem;
    margin-left: auto;
    padding-left: 1.5rem;
  }

  .form-card {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 2rem;
    background: var(--color-surface);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  input[type="text"],
  input[type="email"],
  textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: var(--color-bg);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.15s;
    width: 100%;
  }

  textarea {
    font-family: var(--font-serif);
    line-height: 1.65;
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-accent);
  }

  /* Mobile optimization */
  @media (max-width: 480px) {
    .form-card {
      padding: 1rem;
      margin-left: calc(-1 * var(--space-sm));
      margin-right: calc(-1 * var(--space-sm));
      width: calc(100% + var(--space-sm) * 2);
      border-radius: 0.5rem;
    }

    .instagram-link {
      width: 100%;
      justify-content: center;
      max-width: 100%;
    }

    .ig-arrow {
      position: absolute;
      margin-left: 0;
      padding-left: 0;
    }
  }
</style>
