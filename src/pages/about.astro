---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — Karina Ko"
  description="Karina Ko is a writer based in Sydney, Australia."
  activeNav="about"
>
  <section class="section">
    <div class="container">
      <div class="about-grid">

        <div>
          <h1 style="margin-bottom: 1.5rem;">About</h1>

          <div class="prose">
            <p>
              Karina Ko is a fiction writer from Gadigal/Sydney, Australia. She writes about female monsters and things she's afraid of. She particularly loves short stories and her writing tends to span across literary and speculative fiction.
            <p>
              Her short stories have been published in Strange Horizons, Island, Mascara Literary Review and elsewhere. She’s been awarded the Deborah Cass Prize, a Varuna scholarship for a novel-writing course, a Varuna fellowship and recognition as a Writing NSW Emerging Writers mentee.
            </p>
            <p> If you ever meet her, she's probably wearing second-hand clothes while salvaging objects from the street.
            </p>
          </div>
          <!--
          <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
            <h2 style="font-size: 1rem; margin-bottom: 1rem;"> </h2>
            <p style="color: var(--color-muted); font-family: var(--font-sans); font-size: 0.9rem;">
              <br>
              <strong style="color: var(--color-text);"> </strong>  <br>
            </p>
          </div>
          -->
        </div>

        <!-- Photo sidebar -->
        <aside class="photo-sidebar">
          <img
            src="/karinaprofile.jpg"
            alt="Karina Ko"
            class="profile-photo"
          />
        </aside>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .photo-sidebar {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
  }

  .profile-photo {
    width: 100%;
    max-width: 280px;
    border-radius: 2px;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .photo-sidebar {
      order: 2;
      position: static;
      text-align: center;
    }

    .profile-photo {
      max-width: 200px;
      margin: 2rem auto 0;
    }
  }
</style>
