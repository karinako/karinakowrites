---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { writingPieces } from '../../data/writingPieces';

// Sort newest first
const pieces = [...writingPieces].sort((a, b) => b.date.localeCompare(a.date));
---
<BaseLayout title="Writing — Karina Ko" activeNav="writing">
  <section class="section">
    <div class="container">
      <h1 style="margin-bottom: 0.5rem;">Writing</h1>
      <p style="color: var(--color-muted); margin-bottom: 2.5rem;">
        Short stories
      </p>

      <div class="card-grid">
        {pieces.map(piece => (
          <article class="writing-card">
            <a href={piece.href} target="_blank" rel="noopener noreferrer">
              <div class="meta">
                <span class="tag">{piece.genre}</span>
                <span>{piece.publication}</span>
                <span>{piece.date.substring(0, 4)}</span>
                {piece.readingTime && <span>{piece.readingTime}</span>}
              </div>
              <h3>{piece.title}</h3>
              <p>{piece.excerpt}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
