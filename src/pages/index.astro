---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readingTime, writingPieces } from '../data/writingPieces';

const featuredPieces = writingPieces.filter(piece => piece.featured);
---

<BaseLayout title="Karina Ko — Writer" activeNav="">
  <!-- Hero -->
  <section class="section" style="padding-top: 5rem; padding-bottom: 5rem;">
    <div class="container">
      <p style="
        font-family: var(--font-sans);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: 1.5rem;
      ">
        Fiction writer — Sydney
      </p>
      <h1 style="margin-bottom: 1.5rem; max-width: 15ch;">
        Karina Ko
      </h1>
      <p style="font-size: 1.05rem; color: var(--color-muted); max-width: 52ch; margin-bottom: 2rem;">
        I write short stories exploring
        identity, monsters, and the spaces in between. My work has appeared in <em>Strange Horizons</em>, <em>Island</em>, <em>Mascara Literary Review</em>. I've been awarded the Deborah Cass Prize, a Writing NSW mentorship, and a Varuna fellowship and novel-writing scholarship.
      </p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/writing" class="btn btn-filled">Read my work</a>
        <a href="/contact" class="btn">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- Featured writing -->
  <section class="section">
    <div class="container">
      <p style="
        font-family: var(--font-sans);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin-bottom: 1.5rem;
      ">
        Featured writing
      </p>
      <div class="card-grid">
        {featuredPieces.map(piece => (
          <article class="writing-card">
            <a href={piece.href} target="_blank" rel="noopener noreferrer">
              <div class="meta">
                <span class="tag">{piece.genre}</span>
                <span>{piece.publication}</span>
                <span>{piece.year}</span>
                {piece.wordCount ? <span>{readingTime(piece.wordCount)}</span> : null}
              </div>
              <h3>{piece.title}</h3>
              <p>{piece.excerpt}</p>
            </a>
          </article>
        ))}
      </div>
      <p style="margin-top: 2rem;">
        <a href="/writing" class="btn">All writing →</a>
      </p>
    </div>
  </section>

</BaseLayout>
